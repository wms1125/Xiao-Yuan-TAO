# ============================================================================
# 校园淘 · 容器化部署环境变量模板
#
# 使用：
#   cp .env.example .env
#   然后把所有 CHANGE_ME 替换成真实值（.env 已在 .gitignore 中，不会入库）
#
# 生成随机口令/密钥：
#   openssl rand -base64 32      # 或  pwgen -s 32 1
# ============================================================================

# ---------- 应用版本（用于镜像 tag）----------
APP_VERSION=1.0.17

# ---------- 数据库 ----------
DB_NAME=campus_tao
DB_USERNAME=root
# 【必填】MySQL root 口令，容器首次启动时生效
DB_PASSWORD=CHANGE_ME_strong_db_password
# 宿主机映射端口（仅绑定 127.0.0.1，避免暴露公网）
MYSQL_PORT=3307

# ---------- 应用安全 ----------
# 【必填】JWT 签名密钥，至少 32 字节；缺失或过短后端会拒绝启动
JWT_SECRET=CHANGE_ME_at_least_32_bytes_random_secret
# 【必填】Druid 监控台账号（默认路径 /druid）
DRUID_LOGIN_USERNAME=ruoyi
DRUID_LOGIN_PASSWORD=CHANGE_ME_druid_console_password

# ---------- 对外端口 ----------
# 后端（仅绑定 127.0.0.1；生产建议只经前端 nginx 反代访问）
BACKEND_PORT=8080
# 前端
UI_PORT=8088

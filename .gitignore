# ===== 构建产物 =====
target/
dist/
*.class

# ===== 前端依赖与打包结果 =====
node_modules/
.vite/
*.local

# ===== 覆盖率报告（jacoco / v8）=====
coverage/
jacoco.exec

# ===== 随包内置运行时（体积大，不入版本库）=====
jdk-17/
mysql-8.0.40/

# ===== 本地构建工具（如随交付包附带的 Maven）=====
.tools/

# ===== 运行时生成 =====
uploadPath/
logs/
*.log

# ===== 容器化部署的真实环境变量（含口令，务必勿入库）=====
# 只忽略仓库根目录下的 .env，不要用 `.env.*` 通配——那会误伤前端已入库的
# campus-tao-ui/.env.development、.env.production、.env.staging。
/.env
/.env.local
/.env.*.local
!/.env.example

# ===== IDE / 编辑器 / 系统 =====
.idea/
.vscode/
*.iml
*.swp
.DS_Store
Thumbs.db

# ===== 浏览器 E2E 产物（Playwright）=====
# 失败时的 trace/video/截图体积大且不可复现，只作为 CI 工件上传，不入库。
campus-tao-ui/test-results/
campus-tao-ui/playwright-report/
campus-tao-ui/.pw-out/
# ===== Playwright 证据目录（outputDir 可按 PW_OUTPUT_DIR 覆盖，全部不入库）=====
campus-tao-ui/.pw-*/

# ===== Python 缓存（tools/ 下的校验脚本会生成）=====
__pycache__/

# ===== 覆盖率报告按日期分目录时产生（避免与既有 coverage/ 规则冲突）=====
campus-tao-ui/coverage-*/

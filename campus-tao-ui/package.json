{
  "name": "ruoyi",
  "version": "3.9.2",
  "description": "若依管理系统",
  "author": "若依",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:prod": "vite build",
    "build:stage": "vite build --mode staging",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{js,vue}\" \"vite/**/*.js\" \"tests/**/*.js\" \"*.js\" \"index.html\"",
    "format:check": "prettier --check \"src/**/*.{js,vue}\" \"vite/**/*.js\" \"tests/**/*.js\" \"*.js\" \"index.html\""
  },
  "repository": {
    "type": "git",
    "url": "https://gitee.com/y_project/RuoYi-Vue.git"
  },
  "dependencies": {
    "@element-plus/icons-vue": "2.3.2",
    "@vueup/vue-quill": "1.2.0",
    "@vueuse/core": "14.1.0",
    "axios": "1.20.0",
    "clipboard": "2.0.11",
    "echarts": "6.1.0",
    "element-plus": "2.13.1",
    "file-saver": "2.0.5",
    "fuse.js": "7.1.0",
    "js-beautify": "1.15.4",
    "js-cookie": "3.0.8",
    "jsencrypt": "3.3.2",
    "nprogress": "0.2.0",
    "pinia": "3.0.4",
    "vue": "3.5.44",
    "vue-cropper": "1.1.1",
    "vue-router": "4.6.4",
    "vuedraggable": "4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vitejs/plugin-vue": "5.2.4",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.11.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "sass": "1.80.6",
    "unplugin-auto-import": "21.1.0",
    "unplugin-vue-setup-extend-plus": "1.0.1",
    "vite": "6.4.4",
    "vite-plugin-compression": "0.5.1",
    "vitest": "4.1.11",
    "vue-eslint-parser": "10.4.1"
  },
  "overrides": {
    "quill": "2.0.2",
    "postcss": "8.5.30"
  },
  "resolutions": {
    "quill": "2.0.2"
  }
}

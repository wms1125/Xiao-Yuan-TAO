<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>ruoyi</artifactId>
        <groupId>com.ruoyi</groupId>
        <version>3.9.2</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>
    <packaging>jar</packaging>
    <artifactId>ruoyi-admin</artifactId>

    <description>
        web服务入口
    </description>

    <dependencies>

        <!-- spring-boot-devtools -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <optional>true</optional> <!-- 表示依赖不会传递 -->
        </dependency>

        <!-- spring-doc -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>

        <!-- 可观测性：健康检查 / 应用信息（Actuator） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- 可观测性：Prometheus 抓取端点（/actuator/prometheus）
             版本由 spring-boot-dependencies 的 micrometer-bom 统一管理，此处不写版本。
             注意：本构件已同步进交付包的离线仓库 .tools/m2-repo，
             否则 verify.bat 默认的 -o 离线构建会在干净机器上失败（v1.0.21 已踩过一次）。 -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <scope>runtime</scope>
        </dependency>

         <!-- Mysql驱动包 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>

        <!-- 核心模块-->
        <dependency>
            <groupId>com.ruoyi</groupId>
            <artifactId>ruoyi-framework</artifactId>
        </dependency>

        <!-- 定时任务-->
        <dependency>
            <groupId>com.ruoyi</groupId>
            <artifactId>ruoyi-quartz</artifactId>
        </dependency>

        <!-- 代码生成-->
        <dependency>
            <groupId>com.ruoyi</groupId>
            <artifactId>ruoyi-generator</artifactId>
        </dependency>

        <!-- 嵌入式 Redis：本地开发/演示用，应用启动时拉起真实 Redis，避免安装外部 Redis for Windows -->
        <dependency>
            <groupId>com.github.codemonstur</groupId>
            <artifactId>embedded-redis</artifactId>
            <version>1.4.3</version>
        </dependency>

        <!-- 数据库版本化迁移：迁移脚本在 ruoyi-admin/src/main/resources/db/migration
             版本由 spring-boot-dependencies BOM 统一管理；flyway-mysql 提供 MySQL 方言支持。

             注意：Spring Boot 4 起自动配置被拆分为独立模块，只引入 flyway-core 不会激活
             FlywayAutoConfiguration（应用能启动但迁移静默不执行）。必须同时引入
             spring-boot-flyway，否则 spring.flyway.* 配置全部失效。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>

        <!-- 单元测试：越权拦截的运行时断言（CampusAuthorizationTest）
             放在 ruoyi-admin 而不是 ruoyi-system，是因为它需要「真实的」PermissionService
             （ruoyi-framework 里的 @Service("ss")），而 framework 依赖 system，反向不可行。
             spring-security-config 提供 @EnableMethodSecurity——即生产环境
             SecurityConfig 上那个让 @PreAuthorize 真正生效的注解。
             spring-boot-starter-test 只进 test 作用域，不改变发行包的依赖面。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
          注意作用域：**不能写 test**。
          spring-security-config 本来就通过 ruoyi-framework 的 spring-boot-starter-security
          以 compile 作用域传递进来，而 ruoyi-framework 的 SecurityConfig 在运行期真的要加载
          HeadersConfigurer$CacheControlConfig。直接声明成 test 会按"就近优先"把传递依赖降级，
          发行 jar 里就少了这些类，启动即 NoClassDefFoundError（本仓库实测过一次）。
          这里显式声明为 compile：既是"用到什么就声明什么"，也把这个坑钉在注释里。
        -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-config</artifactId>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <addResources>true</addResources>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>   
                <groupId>org.apache.maven.plugins</groupId>   
                <artifactId>maven-war-plugin</artifactId>   
                <version>3.1.0</version>   
                <configuration>
                    <failOnMissingWebXml>false</failOnMissingWebXml>
                    <warName>${project.artifactId}</warName>
                </configuration>   
           </plugin>   
        </plugins>
        <finalName>${project.artifactId}</finalName>
    </build>

</project>
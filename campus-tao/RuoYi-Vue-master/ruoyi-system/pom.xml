<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>ruoyi</artifactId>
        <groupId>com.ruoyi</groupId>
        <version>3.9.2</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>ruoyi-system</artifactId>

    <description>
        system系统模块
    </description>

    <dependencies>

        <!-- 通用工具-->
        <dependency>
            <groupId>com.ruoyi</groupId>
            <artifactId>ruoyi-common</artifactId>
        </dependency>

        <!-- 参数校验（Jakarta Bean Validation）：campus 模块 DTO 与部分系统模块类在编译期依赖 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- 业务指标 API（MeterRegistry / Counter / Gauge）：校园淘 CampusMetrics 在编译期依赖。
             注册表实现（Prometheus）由 ruoyi-admin 的 micrometer-registry-prometheus 在运行时提供，
             本模块只依赖核心 API，避免把具体注册表焊死在业务模块里。 -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
        </dependency>

        <!-- JSON 解析：campus 外呼通道与物流轨迹 Provider 解析网关响应；显式声明避免依赖传递被上游升级破坏 -->
        <dependency>
            <groupId>com.alibaba.fastjson2</groupId>
            <artifactId>fastjson2</artifactId>
        </dependency>

        <!-- 单元测试（校园淘）：JUnit 5 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 原子扣款 JDBC 测试需要，版本由 Spring Boot BOM 管理 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
          HTTP 层测试（CampusHttpLayerTest）需要：MockMvcBuilders.standaloneSetup 会实例化
          DispatcherServlet，而 spring-boot-starter-test 只带 spring-test、不带 spring-webmvc。
          若不加这条，测试会在 MockMvcBuilders:77 抛 NoClassDefFoundError，
          表现为"测试跑不起来"而不是"测试失败"，容易被误判成环境问题。
          只进 test 作用域：业务代码不依赖 MVC 框架的具体实现。
        -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webmvc</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
          Servlet API 显式声明为 provided：主代码 TraceIdFilter 直接实现 jakarta.servlet.Filter，
          "编译期需要、运行期由容器提供"正是 provided 的语义。
          此前靠 ruoyi-common 的 compile 作用域传递进来——能用，但属于隐式依赖：
          上游把这一条删掉或改作用域，本模块会在主源码编译阶段炸掉，且报错指向业务代码而非 pom。
          注意不能声明为 test：直接声明会覆盖传递依赖的作用域（Maven 就近优先），
          实测把主源码编译打挂（TraceIdFilter 报"找不到 jakarta.servlet"）。
        -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <!--
              覆盖率门禁（校园淘模块）：
              - prepare-agent：仅在跑测试时对 com.ruoyi.campus 下的类插桩；
              - report：绑定 test 阶段，产出 target/site/jacoco 报告（HTML + CSV）；
              - check：绑定 verify 阶段，行覆盖率低于阈值即构建失败。
              阈值为"棘轮基线"：以实测值向下取整设定，只允许上调，不允许下调。
              历史：36.05% / 19.09% →（2026-10-16 补 service 层交易单测）55% / 40%
                   →（2026-10-17 补商品/购物车 service 单测与支付网关用例）70% / 62%
                   →（2026-10-17 补 HTTP 层测试与权限守护）71% / 63%。
              本次上调依据：jacoco.csv 独立实算 行 76.02%（1119/1472）、分支 68.73%（367/534），
              阈值在实测值下方留出约 5 个百分点——余量只为吸收无关改动的正常抖动，
              不再容纳"20 点级别的覆盖率塌方"。
              Controller 层与 DTO 层已 100% 覆盖；service 层交易链路（下单/支付/取消/
              超时取消/售后审核）已补齐，剩余缺口在 notify/logistics 等外部网关适配层。
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <configuration>
                    <!--
                      统计口径：只统计"业务逻辑类"。
                      排除 domain/**（纯 POJO，getter/setter 无逻辑价值）与 mapper/**（MyBatis 接口代理，无字节码）。
                    -->
                    <includes>
                        <include>com/ruoyi/campus/**</include>
                    </includes>
                    <excludes>
                        <exclude>com/ruoyi/campus/domain/**</exclude>
                        <exclude>com/ruoyi/campus/mapper/**</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.71</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.63</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!--
              静态检查门禁（校园淘模块）：Checkstyle。
              与 Spotless 的分工：Spotless 管「排版卫生」（未用 import、行尾空白、文件末尾换行），
              Checkstyle 管「客观缺陷」——通配符 import、重复 import、未使用局部变量、
              省略花括号、空 catch 块等确定性错误，两者不重复报告同一类问题。
              作用域刻意只限 com/ruoyi/campus/**（本项目自有代码）；若依脚手架属上游债务，
              不在本门禁口径内——与前端「全仓 0 error + 自有目录 0 warning」两档口径同构。
              规则集见 config/checkstyle/campus-checkstyle.xml，只允许增设规则，不允许为通过而删规则。
              门禁绑定 verify 阶段：任一次 `mvn verify`（含 CI 的 `mvn -B verify`）都会执行，
              不达标即构建失败；本插件刻意不提供自动改写，避免"边构建边改源码"掩盖问题。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>${checkstyle.plugin.version}</version>
                <dependencies>
                    <dependency>
                        <groupId>com.puppycrawl.tools</groupId>
                        <artifactId>checkstyle</artifactId>
                        <version>${checkstyle.version}</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <configLocation>${maven.multiModuleProjectDirectory}/config/checkstyle/campus-checkstyle.xml</configLocation>
                    <includeTestSourceDirectory>true</includeTestSourceDirectory>
                    <includes>**/com/ruoyi/campus/**/*.java</includes>
                    <sourceDirectories>
                        <sourceDirectory>${project.build.sourceDirectory}</sourceDirectory>
                        <sourceDirectory>${project.build.testSourceDirectory}</sourceDirectory>
                    </sourceDirectories>
                    <consoleOutput>true</consoleOutput>
                    <failsOnError>false</failsOnError>
                    <violationSeverity>error</violationSeverity>
                    <linkXRef>false</linkXRef>
                </configuration>
                <executions>
                    <execution>
                        <id>checkstyle-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!--
              静态检查门禁（校园淘模块）：SpotBugs（字节码级缺陷分析）。
              与 Checkstyle 的分工：Checkstyle 读源码、查结构化问题（import/花括号/空块）；
              SpotBugs 读字节码、查语义级缺陷（空指针路径、错误的相等比较、装箱拆箱往返、
              资源未关闭等），两者互补，不重复报告同一问题。
              作用域：onlyAnalyze 限定 com.ruoyi.campus.**，若依脚手架不纳入本门禁口径。
              排除规则见 config/spotbugs/campus-spotbugs-exclude.xml（domain 纯 POJO 与
              Date 暴露类噪声，理由逐条写在规则文件里）。
              强度：effort=Max + threshold=Medium——只报中高置信度的确定缺陷，不报低置信度猜测。
              门禁绑定 verify 阶段；产出 target/spotbugsXml.xml（CI 随报告一并归档）。
            -->
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <version>${spotbugs.plugin.version}</version>
                <configuration>
                    <effort>Max</effort>
                    <threshold>Medium</threshold>
                    <onlyAnalyze>com.ruoyi.campus.-</onlyAnalyze>
                    <excludeFilterFile>${maven.multiModuleProjectDirectory}/config/spotbugs/campus-spotbugs-exclude.xml</excludeFilterFile>
                    <failOnError>true</failOnError>
                    <xmlOutput>true</xmlOutput>
                </configuration>
                <executions>
                    <execution>
                        <id>spotbugs-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
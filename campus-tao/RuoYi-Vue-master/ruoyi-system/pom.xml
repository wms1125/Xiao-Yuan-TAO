<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>ruoyi</artifactId>
        <groupId>com.ruoyi</groupId>
        <version>3.9.2</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>ruoyi-system</artifactId>

    <description>
        system系统模块
    </description>

    <dependencies>

        <!-- 通用工具-->
        <dependency>
            <groupId>com.ruoyi</groupId>
            <artifactId>ruoyi-common</artifactId>
        </dependency>

        <!-- 参数校验（Jakarta Bean Validation）：campus 模块 DTO 与部分系统模块类在编译期依赖 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- JSON 解析：campus 外呼通道与物流轨迹 Provider 解析网关响应；显式声明避免依赖传递被上游升级破坏 -->
        <dependency>
            <groupId>com.alibaba.fastjson2</groupId>
            <artifactId>fastjson2</artifactId>
        </dependency>

        <!-- 单元测试（校园淘）：JUnit 5 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 原子扣款 JDBC 测试需要，版本由 Spring Boot BOM 管理 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <!--
              覆盖率门禁（校园淘模块）：
              - prepare-agent：仅在跑测试时对 com.ruoyi.campus 下的类插桩；
              - report：绑定 test 阶段，产出 target/site/jacoco 报告（HTML + CSV）；
              - check：绑定 verify 阶段，行覆盖率低于阈值即构建失败。
              阈值为"棘轮基线"：2026-10-16 补齐 service 层交易逻辑单测后实测
              行 58.43% / 分支 43.79%（此前 36.05% / 19.09%），本次上调至
              行 55% / 分支 40%（在实测值下方留出余量），后续只允许上调，不允许下调。
              Controller 层与 DTO 层已 100% 覆盖；service 层交易链路（下单/支付/取消/
              超时取消/售后审核）本轮补齐，剩余缺口在 notify/logistics 等外部网关适配层。
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <configuration>
                    <!--
                      统计口径：只统计"业务逻辑类"。
                      排除 domain/**（纯 POJO，getter/setter 无逻辑价值）与 mapper/**（MyBatis 接口代理，无字节码）。
                    -->
                    <includes>
                        <include>com/ruoyi/campus/**</include>
                    </includes>
                    <excludes>
                        <exclude>com/ruoyi/campus/domain/**</exclude>
                        <exclude>com/ruoyi/campus/mapper/**</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.55</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.40</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
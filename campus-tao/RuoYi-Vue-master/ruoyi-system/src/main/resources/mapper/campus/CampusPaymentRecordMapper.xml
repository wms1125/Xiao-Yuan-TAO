<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.campus.mapper.CampusPaymentRecordMapper">
    <resultMap type="com.ruoyi.campus.domain.CampusPaymentRecord" id="CampusPaymentRecordResult">
        <id property="id" column="id"/>
        <result property="orderNo" column="order_no"/>
        <result property="userId" column="user_id"/>
        <result property="sellerId" column="seller_id"/>
        <result property="amount" column="amount"/>
        <result property="tradeType" column="trade_type"/>
        <result property="channel" column="channel"/>
        <result property="channelTradeNo" column="channel_trade_no"/>
        <result property="status" column="status"/>
        <result property="remark" column="remark"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, order_no, user_id, seller_id, amount, trade_type, channel, channel_trade_no,
        status, remark, create_time
    </sql>

    <insert id="insertCampusPaymentRecord" parameterType="com.ruoyi.campus.domain.CampusPaymentRecord" useGeneratedKeys="true" keyProperty="id">
        insert into campus_payment_record (order_no, user_id, seller_id, amount, trade_type, channel, channel_trade_no, status, remark)
        values (#{orderNo}, #{userId},
            <choose><when test="sellerId != null">#{sellerId}</when><otherwise>null</otherwise></choose>,
            #{amount}, #{tradeType}, #{channel},
            <choose><when test="channelTradeNo != null">#{channelTradeNo}</when><otherwise>''</otherwise></choose>,
            #{status},
            <choose><when test="remark != null">#{remark}</when><otherwise>''</otherwise></choose>)
    </insert>

    <select id="selectByOrderNo" resultMap="CampusPaymentRecordResult">
        select <include refid="Base_Column_List"/> from campus_payment_record
        where order_no = #{orderNo}
        order by create_time asc, id asc
    </select>
</mapper>
<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.campus.mapper.CampusNoticeMapper">
    <resultMap type="com.ruoyi.campus.domain.CampusNotice" id="CampusNoticeResult">
        <id property="noticeId" column="notice_id"/>
        <result property="userId" column="user_id"/>
        <result property="type" column="type"/>
        <result property="title" column="title"/>
        <result property="content" column="content"/>
        <result property="bizNo" column="biz_no"/>
        <result property="isRead" column="is_read"/>
        <result property="createTime" column="create_time"/>
        <result property="readTime" column="read_time"/>
    </resultMap>

    <sql id="Base_Column_List">
        notice_id, user_id, type, title, content, biz_no, is_read, create_time, read_time
    </sql>

    <insert id="insertCampusNotice" parameterType="com.ruoyi.campus.domain.CampusNotice" useGeneratedKeys="true" keyProperty="noticeId">
        insert into campus_notice (user_id, type, title, content, biz_no, is_read)
        values (#{userId}, #{type}, #{title}, #{content}, #{bizNo}, 0)
    </insert>

    <select id="selectByNoticeId" resultMap="CampusNoticeResult">
        select <include refid="Base_Column_List"/> from campus_notice where notice_id = #{noticeId}
    </select>

    <!--
      我的通知（分页 + 按类型筛选）。

      排序保持 is_read asc（未读在前）、create_time desc（新的在前），与原来无界版一致，
      否则"未读置顶"的行为会随分页悄悄消失。

      索引：where 命中 (user_id, is_read) 前缀，再加 create_time 排序。
      原有的 idx_user_read(user_id, is_read) 能定位到该用户所有行，
      但"未读 + 按时间倒序"在未读数很多时仍要回表排序。
      本仓库另有 V6 迁移补的 (user_id, is_read, create_time) 联合索引，
      使"只看未读"的常见场景直接按索引顺序取前 N 条，不再 filesort。
    -->
    <select id="selectListByUserPaged" resultMap="CampusNoticeResult">
        select <include refid="Base_Column_List"/> from campus_notice
        <where>
            user_id = #{userId}
            <if test="isRead != null">and is_read = #{isRead}</if>
            <if test="type != null and type != ''">and type = #{type}</if>
        </where>
        order by is_read asc, create_time desc
        limit #{offset}, #{limit}
    </select>

    <!-- 与列表同一筛选条件的总数；列表筛了 type 而总数没筛，翻页控件就会显示错的总页数 -->
    <select id="countByUser" resultType="java.lang.Long">
        select count(1) from campus_notice
        <where>
            user_id = #{userId}
            <if test="isRead != null">and is_read = #{isRead}</if>
            <if test="type != null and type != ''">and type = #{type}</if>
        </where>
    </select>

    <select id="selectListByUser" resultMap="CampusNoticeResult">
        select <include refid="Base_Column_List"/> from campus_notice
        <where>
            user_id = #{userId}
            <if test="isRead != null">and is_read = #{isRead}</if>
        </where>
        order by is_read asc, create_time desc
        <if test="limit != null">limit #{limit}</if>
    </select>

    <select id="countUnread" resultType="int">
        select count(1) from campus_notice where user_id = #{userId} and is_read = 0
    </select>

    <update id="markRead">
        update campus_notice set is_read = 1, read_time = #{readTime}
        where notice_id = #{noticeId} and user_id = #{userId} and is_read = 0
    </update>

    <update id="markReadAll">
        update campus_notice set is_read = 1, read_time = #{readTime}
        where user_id = #{userId} and is_read = 0
    </update>
</mapper>

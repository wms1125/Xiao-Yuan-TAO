<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.campus.mapper.CampusUserPayQrMapper">
    <resultMap type="com.ruoyi.campus.domain.CampusUserPayQr" id="CampusUserPayQrResult">
        <id property="userId" column="user_id"/>
        <result property="qrUrl" column="qr_url"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <select id="selectByUserId" resultMap="CampusUserPayQrResult">
        select user_id, qr_url, create_time, update_time
        from campus_user_pay_qr
        where user_id = #{userId}
    </select>

    <!-- 一人一码：主键冲突即覆盖旧码，保证任何并发顺序下最终一致 -->
    <insert id="upsert">
        insert into campus_user_pay_qr (user_id, qr_url)
        values (#{userId}, #{qrUrl})
        on duplicate key update qr_url = #{qrUrl}
    </insert>
</mapper>

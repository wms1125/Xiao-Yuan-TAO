<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.campus.mapper.CampusOrderMapper">
    <resultMap type="com.ruoyi.campus.domain.CampusOrder" id="CampusOrderResult">
        <id property="id" column="id"/>
        <result property="orderNo" column="order_no"/>
        <result property="userId" column="user_id"/>
        <result property="userName" column="user_name"/>
        <result property="totalAmount" column="total_amount"/>
        <result property="status" column="status"/>
        <result property="receiverName" column="receiver_name"/>
        <result property="receiverPhone" column="receiver_phone"/>
        <result property="address" column="address"/>
        <result property="remark" column="remark"/>
        <result property="payTime" column="pay_time"/>
        <result property="shipTime" column="ship_time"/>
        <result property="logisticsNo" column="logistics_no"/>
        <result property="addressSnapshot" column="address_snapshot"/>
        <result property="finishTime" column="finish_time"/>
        <result property="cancelTime" column="cancel_time"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <resultMap type="com.ruoyi.campus.domain.vo.CampusStatusStat" id="StatusStatResult">
        <result property="status" column="status"/>
        <result property="count" column="cnt"/>
        <result property="amount" column="amount"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, order_no, user_id, user_name, total_amount, status, receiver_name, receiver_phone,
        address, remark, pay_time, ship_time, logistics_no, address_snapshot,
        finish_time, cancel_time, create_time, update_time
    </sql>

    <!--
      address_snapshot 在库中是 `NOT NULL DEFAULT ''`。
      注意：MySQL 的 DEFAULT 只在**列被省略**时生效——若显式传入 NULL 仍会触发
      `Column 'address_snapshot' cannot be null`。而本 mapper 是通用入口，
      不保证调用方一定 set 过该字段，故在此用 COALESCE 兜底为 ''，
      同时显式声明 jdbcType=VARCHAR 避免 MyBatis 对 null 推断成 OTHER。
    -->
    <insert id="insertCampusOrder" parameterType="com.ruoyi.campus.domain.CampusOrder" useGeneratedKeys="true" keyProperty="id">
        insert into campus_order (order_no, user_id, user_name, total_amount, status,
            receiver_name, receiver_phone, address, remark, address_snapshot)
        values (#{orderNo}, #{userId}, #{userName}, #{totalAmount}, #{status},
            #{receiverName}, #{receiverPhone}, #{address}, #{remark},
            COALESCE(#{addressSnapshot,jdbcType=VARCHAR}, ''))
    </insert>

    <update id="updateCampusOrder" parameterType="com.ruoyi.campus.domain.CampusOrder">
        update campus_order
        <set>
            <if test="status != null">status = #{status},</if>
            <if test="receiverName != null">receiver_name = #{receiverName},</if>
            <if test="receiverPhone != null">receiver_phone = #{receiverPhone},</if>
            <if test="address != null">address = #{address},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="payTime != null">pay_time = #{payTime},</if>
            <if test="shipTime != null">ship_time = #{shipTime},</if>
            <if test="logisticsNo != null">logistics_no = #{logisticsNo},</if>
            <if test="finishTime != null">finish_time = #{finishTime},</if>
            <if test="cancelTime != null">cancel_time = #{cancelTime},</if>
        </set>
        where id = #{id}
    </update>

    <select id="selectOrderByOrderNo" resultMap="CampusOrderResult">
        select <include refid="Base_Column_List"/> from campus_order where order_no = #{orderNo} limit 1
    </select>

    <select id="selectOrderById" resultMap="CampusOrderResult">
        select <include refid="Base_Column_List"/> from campus_order where id = #{id}
    </select>

    <!-- 列表与概览共用同一筛选条件，避免两处 where 漂移 -->
    <sql id="Filter_Where">
        <where>
            <if test="userId != null">and user_id = #{userId}</if>
            <if test="status != null">and status = #{status}</if>
            <if test="orderNo != null and orderNo != ''">and order_no like concat('%', #{orderNo}, '%')</if>
        </where>
    </sql>

    <select id="selectOrderList" resultMap="CampusOrderResult">
        select <include refid="Base_Column_List"/> from campus_order
        <include refid="Filter_Where"/>
        order by create_time desc
    </select>

    <!-- 概览聚合：分页后前端不再遍历当前页推导数字，改由本查询按同一筛选条件聚合 -->
    <select id="countGroupByStatus" resultMap="StatusStatResult">
        select status as status, count(1) as cnt
        from campus_order
        <include refid="Filter_Where"/>
        group by status
    </select>

    <select id="countByUserId" resultType="int">
        select count(1) from campus_order where user_id = #{userId}
    </select>

    <!-- 超时未支付订单：仅取待付款(0)且创建时间早于 deadline -->
    <select id="selectTimeoutWaitPayOrders" resultMap="CampusOrderResult">
        select <include refid="Base_Column_List"/> from campus_order
        where status = 0 and create_time &lt; #{deadline}
        order by create_time asc
    </select>

    <!-- 已发货且有物流单号的订单：供物流轨迹定时同步使用 -->
    <select id="selectShippedOrders" resultMap="CampusOrderResult">
        select <include refid="Base_Column_List"/> from campus_order
        where status = 2 and logistics_no is not null and logistics_no != ''
        order by ship_time asc
        <if test="limit != null">limit #{limit}</if>
    </select>

    <!-- 原子取消：仅当仍为待付款时才置为已取消，避免与用户支付/取消并发冲突 -->
    <update id="cancelWaitPayOrderIfStillWaitPay">
        update campus_order set status = 4, cancel_time = #{cancelTime}
        where order_no = #{orderNo} and status = 0
    </update>
</mapper>

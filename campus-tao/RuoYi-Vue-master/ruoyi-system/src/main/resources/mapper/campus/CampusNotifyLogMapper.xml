<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.campus.mapper.CampusNotifyLogMapper">
    <resultMap type="com.ruoyi.campus.domain.CampusNotifyLog" id="CampusNotifyLogResult">
        <id property="logId" column="log_id"/>
        <result property="userId" column="user_id"/>
        <result property="channel" column="channel"/>
        <result property="target" column="target"/>
        <result property="type" column="type"/>
        <result property="title" column="title"/>
        <result property="content" column="content"/>
        <result property="bizNo" column="biz_no"/>
        <result property="status" column="status"/>
        <result property="response" column="response"/>
        <result property="errorMsg" column="error_msg"/>
        <result property="costMs" column="cost_ms"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <sql id="Base_Column_List">
        log_id, user_id, channel, target, type, title, content, biz_no, status, response, error_msg, cost_ms, create_time
    </sql>

    <insert id="insertCampusNotifyLog" parameterType="com.ruoyi.campus.domain.CampusNotifyLog"
            useGeneratedKeys="true" keyProperty="logId">
        insert into campus_notify_log (user_id, channel, target, type, title, content, biz_no, status, response, error_msg, cost_ms)
        values (#{userId}, #{channel}, #{target}, #{type}, #{title}, #{content}, #{bizNo}, #{status}, #{response}, #{errorMsg}, #{costMs})
    </insert>

    <select id="selectList" resultMap="CampusNotifyLogResult">
        select <include refid="Base_Column_List"/> from campus_notify_log
        <where>
            <if test="channel != null and channel != ''">and channel = #{channel}</if>
            <if test="status != null">and status = #{status}</if>
            <if test="userId != null">and user_id = #{userId}</if>
            <if test="bizNo != null and bizNo != ''">and biz_no = #{bizNo}</if>
        </where>
        order by create_time desc, log_id desc
        <if test="limit != null">limit #{limit}</if>
    </select>
</mapper>
